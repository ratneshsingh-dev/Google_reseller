# =============================================================================
# Google Workspace Provisioning System - Environment Configuration
# =============================================================================

# --- GCP Configuration ---
GOOGLE_CLOUD_PROJECT=testing-ratnesh
FIRESTORE_DATABASE=(default)
GCS_BUCKET=workspace-provisioning-bucket

# --- Storage Mode ---
# Set to "true" to use real Firestore; "false" for in-memory storage
USE_FIRESTORE=false

# --- Service Adapter ---
# "mock" = use mock Google APIs; "google" = use real Google APIs
SERVICE_ADAPTER=mock

# --- Mock Failure Simulation ---
MOCK_FAILURE_MODE=false
MOCK_FAILURE_RATE=0.0

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Application ---
APP_NAME=Google Workspace Provisioning System
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Google Application Credentials (local dev only) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
