# =============================================================================
# .gitignore — What NEVER goes to GitHub
# =============================================================================

# --- Secrets (NEVER commit these) ---
.env
.env.dev
.env.prod
credentials.json
credentials-*.json
*-service-account.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# --- Virtual environments ---
venv/
.venv/
env/

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
