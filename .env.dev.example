# =============================================================================
# DEV Environment Config — used for the 'dev' branch / Cloud Run dev service
# =============================================================================
# Copy this file → DO NOT commit to GitHub
# On Cloud Run dev, set these as Environment Variables in the console.

# --- GCP Project (DEV uses a SEPARATE Firestore database) ---
GOOGLE_CLOUD_PROJECT=reseller-integration
FIRESTORE_DATABASE=dev          # <-- separate DB from prod, named "dev"
GCS_BUCKET=workspace-provisioning-bucket-dev

# --- Storage & Adapter (real Google APIs, but dev Firestore) ---
USE_FIRESTORE=true
SERVICE_ADAPTER=google

# --- Google OAuth (same client ID is fine for dev) ---
GOOGLE_OAUTH_CLIENT_ID="1006217259056-m1tihhq0q1j77ljo0i4gincg6lct8278.apps.googleusercontent.com"
GOOGLE_ADMIN_EMAIL=Admin@supportnation.co.in

# --- CORS (add your Cloud Run dev URL after first deploy) ---
CORS_ORIGINS=["http://localhost:8000","https://YOUR-DEV-CLOUDRUN-URL.run.app"]

# --- App ---
APP_NAME=Google Workspace Provisioning System (DEV)
APP_VERSION=1.0.0
LOG_LEVEL=DEBUG

# --- Admin Access ---
ADMIN_EMAILS=["ratnesh.s@econz.net","Admin@supportnation.co.in"]

# --- JWT ---
JWT_SECRET_KEY=dev-secret-key-replace-before-production-2026
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# --- Mock Settings ---
MOCK_FAILURE_MODE=false
MOCK_FAILURE_RATE=0.0
