# =============================================================================
# PROD Environment Config — used for the 'main' branch / Cloud Run prod service
# =============================================================================
# Copy this file → DO NOT commit to GitHub
# On Cloud Run prod, set these as Environment Variables in the console.

# --- GCP Project (PROD uses the default Firestore database) ---
GOOGLE_CLOUD_PROJECT=reseller-integration
FIRESTORE_DATABASE=(default)    # <-- the real prod database
GCS_BUCKET=workspace-provisioning-bucket

# --- Storage & Adapter ---
USE_FIRESTORE=true
SERVICE_ADAPTER=google

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID="1006217259056-m1tihhq0q1j77ljo0i4gincg6lct8278.apps.googleusercontent.com"
GOOGLE_ADMIN_EMAIL=Admin@supportnation.co.in

# --- CORS (add your Cloud Run prod URL after first deploy) ---
CORS_ORIGINS=["https://YOUR-PROD-CLOUDRUN-URL.run.app"]

# --- App ---
APP_NAME=Google Workspace Provisioning System
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Admin Access ---
ADMIN_EMAILS=["ratnesh.s@econz.net","Admin@supportnation.co.in"]

# --- JWT (use a strong random key in prod — NOT the dev key) ---
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_KEY_IN_PRODUCTION
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# --- Mock Settings ---
MOCK_FAILURE_MODE=false
MOCK_FAILURE_RATE=0.0
